{
  "name": "sam-uijeongbu-dashboard",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3220",
    "dev:mock": "MOCK_BACKEND=true next dev -p 3220",
    "build": "next build",
    "start": "next start -p 3220",
    "typecheck": "tsc --noEmit",
    "lint": "eslint && node scripts/check-hex.mjs && node scripts/check-spacing.mjs && node scripts/check-font-size.mjs",
    "format": "prettier --write \"{src,app,e2e-pw}/**/*.{ts,tsx}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"{src,app,e2e-pw}/**/*.{ts,tsx}\" \"*.{ts,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integration": "E2E_TARGET=integration playwright test",
    "check:hex": "node scripts/check-hex.mjs",
    "icons": "node scripts/gen-iconify-bundle.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "rm:all": "rm -rf node_modules .next .next-* out dist build"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@iconify/react": "6.0.4",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@tanstack/react-query": "5.108.0",
    "next": "16.4.6",
    "notistack": "3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@iconify-json/solar": "1.2.16",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}

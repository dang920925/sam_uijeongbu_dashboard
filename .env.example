# ─── 서버 연결 (서버 전용 — BFF 만 읽는다. NEXT_PUBLIC_* 는 쓰지 않는다) ───
# NestJS 서버 배포 URL. BFF 가 뒤에 /api/v1/... 을 붙인다. 예: https://sam-uijeongbu-server.vercel.app
# local: http://localhost:4100 (server `pnpm start local`) · development·production: 서버 Vercel 배포 주소(자리표시 — 사용자가 채움)
API_BASE_URL=
# 중계 비밀(qa1 U11) — 서버·홈페이지와 같은 RELAY_SECRET. BFF 가 방문자 IP(X-Visitor-IP)와 함께 보내 서버가 방문자별로
# 레이트리밋을 센다. 비우면 보내지 않고 서버는 BFF IP 로 센다(기능은 동작). local: server .env.local 값 복사 · 운영: Sensitive
RELAY_SECRET=
# Supabase Storage 호스트(<ref>.supabase.co) — 이미지 공개 URL 의 호스트. 이미지는 unoptimized 로 그대로 쓴다.
IMAGE_HOST=

# ─── 홈페이지 연결 (R1 — U24 초대 링크 · U27 즉시 반영) ───
# 홈페이지 공개 주소(끝 / 없이). 초대 링크 `{CLIENT_PUBLIC_URL}/works/{공연 id}/book?ref={코드}` 와
# 저장·삭제 뒤 홈페이지 재검증 호출(`POST {CLIENT_PUBLIC_URL}/api/revalidate`)에 쓴다. 비우면 둘 다 꺼진다.
# local: http://localhost:3000(홈페이지 dev) · production: https://sam-uijeongbu-client.vercel.app
CLIENT_PUBLIC_URL=
# 홈페이지와 같은 재검증 비밀(develop §12.1, 32자 이상, 운영 Sensitive). 32자 미만이면 호출을 건너뛴다(부팅은 계속).
REVALIDATE_SECRET=

# ─── 로컬 목 백엔드 (서버 없이 개발·E2E — Vercel 에서는 켤 수 없음) ───
# true 면 BFF 가 메모리 목(src/_mock)으로 응답한다. API_BASE_URL 이 있으면 비워 둔다.
MOCK_BACKEND=
# 목 로그인 자격 증명(개발 전용 값, 운영 비밀 아님)
MOCK_ADMIN_USERNAME=
MOCK_ADMIN_PASSWORD=
